# Copy to .env next to docker-compose.yml. Docker Compose reads .env automatically.
# Do not commit .env.

# Host user that owns the bind-mounted data directory and can read the music tree.
VELIN_UID=1000
VELIN_GID=1000

# Host paths. Music is mounted read-only at /music inside the container.
VELIN_DATA_DIR=./data
VELIN_MUSIC_DIR=./music

VELIN_PORT=8080
VELIN_VERSION=dev

# Optional. Used when creating pairing QR payloads without an explicit server_url.
# VELIN_PUBLIC_URL=https://home.example/velin

# Set true when HTTPS terminates at a reverse proxy.
VELIN_SECURE_COOKIES=false

VELIN_SCAN_ON_STARTUP=false
# VELIN_SCAN_INTERVAL=6h
